{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zetkin/employee",
  "version": "0.1.0",
  "title": "Zetkin Employee",
  "category": "zetkin",
  "icon": "id-alt",
  "description": "",
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "ztk",
  "attributes": {
    "name": {
      "type": "string",
      "default": "John Doe"
    },
    "title": {
      "type": "string",
      "default": "Superhero"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number"
    },
    "imageSize": {
      "type": "string",
      "default": "full"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}