{
  "name": "new-zetkin-org",
  "version": "1.0.0",
  "description": "New website for Zetkin Foundation",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=./zetkin-theme/blocks --output-path=./zetkin-theme/build --webpack-copy-php",
    "format": "wp-scripts format --webpack-src-dir=./zetkin-theme/blocks --output-path=./zetkin-theme/build",
    "lint:css": "wp-scripts lint-style --webpack-src-dir=./zetkin-theme/blocks --output-path=./zetkin-theme/build",
    "lint:js": "wp-scripts lint-js --webpack-src-dir=./zetkin-theme/blocks --output-path=./zetkin-theme/build",
    "start": "wp-scripts start --webpack-src-dir=./zetkin-theme/blocks --output-path=./zetkin-theme/build --webpack-copy-php",
    "wp": "wp-env"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zetkin/new-zetkin-org.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/zetkin/new-zetkin-org/issues"
  },
  "private": true,
  "homepage": "https://github.com/zetkin/new-zetkin-org#readme",
  "devDependencies": {
    "@wordpress/env": "^9.2.0",
    "@wordpress/scripts": "^27.7.0"
  },
  "dependencies": {
    "@wordpress/server-side-render": "^4.33.0",
    "clsx": "^2.1.1"
  }
}
